# =============================================================================
# Servicio de monitoreo de Comondurismo - configuracion por variables de entorno
# =============================================================================
#
# Copia este archivo a "env/monitor.env" (no se versiona). compose.yml ya fija PORT,
# DATABASE_URL, DOCKER_HOST, COMPOSE_PROJECT, REDIS_*, IDENTITY_JWKS_URL y OBJECT_STORE_ENDPOINT
# con sus claves, y esos valores tienen prioridad sobre este archivo: aqui solo va lo opcional.
# Todo lo de abajo tiene valor por defecto, asi que el archivo puede quedar tal cual.
#
# Duraciones en formato Go: 30s, 15m, 72h. Sin comillas ni "export".

# [OPCIONAL, defecto false] Aplica las migraciones al arrancar. Con false, ejecuta
# "docker compose run --rm monitor /migrate up" tras cada actualizacion.
AUTO_MIGRATE=false

# [OPCIONAL, defecto comondurismo-api] Emisor esperado en los tokens (JWT_ISSUER de identidad).
JWT_ISSUER=comondurismo-api

# [OPCIONAL, defecto comondurismo-logs] Bucket donde se archivan los logs por hora
# (.jsonl.gz). Se crea PRIVADO si no existe: los archivos solo se descargan por la API.
OBJECT_STORE_BUCKET=comondurismo-logs
OBJECT_STORE_USE_SSL=false

# [OPCIONAL] Cada cuanto se mide el consumo, se leen los logs y se archivan las horas completas.
MONITOR_SAMPLE_INTERVAL=30s
MONITOR_LOG_INTERVAL=15s
MONITOR_ARCHIVE_INTERVAL=5m

# [OPCIONAL] Retencion: muestras de consumo (30 dias), lineas de log consultables en la base
# (7 dias) y archivos de log en el almacenamiento (90 dias).
MONITOR_METRICS_RETENTION=720h
MONITOR_LOG_DB_RETENTION=168h
MONITOR_LOG_FILE_RETENTION=2160h

# [OPCIONAL, defecto 5000] Lineas maximas que se leen de un contenedor en cada pasada.
MONITOR_MAX_LINES_PER_PULL=5000
