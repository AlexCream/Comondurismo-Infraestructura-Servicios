# Variables del servicio de monitoreo de Comondurismo.
# En el despliegue con docker compose (repositorio de infraestructura), DATABASE_URL,
# DOCKER_HOST, COMPOSE_PROJECT, REDIS_*, IDENTITY_JWKS_URL y OBJECT_STORE_ENDPOINT y sus
# claves los define compose.yml; aqui solo hace falta lo opcional.

# [OBLIGATORIO fuera de compose] Base de datos propia del monitor (una base por servicio).
DATABASE_URL=

# [OPCIONAL, defecto false] Aplica las migraciones al arrancar.
AUTO_MIGRATE=false

# [OPCIONAL, defecto 50312] Puerto interno. No se publica: lo consulta contenido.
PORT=50312

# [OPCIONAL, defecto tcp://comondurismo-docker-proxy:2375] API de Docker. Debe ser el proxy de
# solo lectura (docker-socket-proxy con CONTAINERS=1 e INFO=1), nunca el socket directo.
DOCKER_HOST=tcp://comondurismo-docker-proxy:2375

# [OPCIONAL, defecto comondurismo-infra] Proyecto de docker compose a monitorear. Los
# contenedores de otros proyectos del mismo servidor se ignoran.
COMPOSE_PROJECT=comondurismo-infra

# [OPCIONAL] Redis (para su estado en GET /manage/system/cache).
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# [OPCIONAL] Verificacion de tokens, igual que contenido.
IDENTITY_JWKS_URL=http://comondurismo-identity:50310/.well-known/jwks.json
JWT_ISSUER=comondurismo-api

# [OBLIGATORIO fuera de compose] Almacenamiento S3 donde se archivan los logs. El bucket se
# crea privado si no existe.
OBJECT_STORE_ENDPOINT=storage:9000
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_BUCKET=comondurismo-logs

# [OPCIONAL] Cada cuanto se mide el consumo, se leen los logs y se archivan las horas completas.
MONITOR_SAMPLE_INTERVAL=30s
MONITOR_LOG_INTERVAL=15s
MONITOR_ARCHIVE_INTERVAL=5m

# [OPCIONAL] Retencion: muestras de consumo (30 dias), lineas de log consultables en la base
# (7 dias) y archivos de log en el almacenamiento (90 dias).
MONITOR_METRICS_RETENTION=720h
MONITOR_LOG_DB_RETENTION=168h
MONITOR_LOG_FILE_RETENTION=2160h

# [OPCIONAL, defecto 5000] Lineas maximas que se leen de un contenedor en cada pasada.
MONITOR_MAX_LINES_PER_PULL=5000
