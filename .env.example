# Variables de la infraestructura de DESARROLLO (compose.yml de esta carpeta).
# Copia este archivo a ".env" (que no se versiona) y define las contrasenas.
#
# Los valores de conexion que el SERVICIO necesita se construyen a partir de estos y
# van en el .env de la raiz del repositorio (ver el .env.example de alli).

# ---- PostgreSQL ----

# Nombre de la base de datos que se crea al primer arranque.
POSTGRES_DB=comondurismo_identity

# Usuario administrador de la base de datos.
POSTGRES_USER=comondurismo

# Contrasena del usuario anterior. OBLIGATORIA: usa una distinta en cada entorno.
POSTGRES_PASSWORD=

# Puerto de tu maquina en el que se publica PostgreSQL (127.0.0.1:<puerto>).
# Todo Comondurismo usa el rango 50300-50400 (ver "Puertos_y_Red" en la boveda de Obsidian).
POSTGRES_PORT=50300

# ---- Redis ----

# Contrasena de Redis. OBLIGATORIA: Redis arranca con autenticacion obligatoria.
REDIS_PASSWORD=

# Puerto de tu maquina en el que se publica Redis (127.0.0.1:<puerto>).
REDIS_PORT=50301

# ---- Mailpit (correo de desarrollo) ----

# Puerto SMTP al que el servicio envia los correos.
MAILPIT_SMTP_PORT=50302

# Puerto de la interfaz web donde ves los correos: http://localhost:50303
MAILPIT_UI_PORT=50303


# ---- Contenido: base de datos y almacenamiento de objetos ----

# Base del servicio de contenido (se crea sola la primera vez; ver postgres/initdb).
POSTGRES_CONTENT_DB=comondurismo_content

# Almacenamiento de objetos S3 (RustFS en desarrollo). OBLIGATORIAS: llave de acceso y
# secreto; el servicio de contenido las usa como OBJECT_STORE_ACCESS_KEY y
# OBJECT_STORE_SECRET_KEY. El secreto debe tener al menos 8 caracteres.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Puertos de tu maquina: API S3 (tambien sirve los archivos publicos) y consola web.
S3_API_PORT=50304
S3_CONSOLE_PORT=50305

# Interfaz en la que escucha la API S3: 127.0.0.1 = solo tu maquina (defecto); 0.0.0.0 = toda
# la red, solo para probar con otros equipos del laboratorio sin nginx. La consola siempre es local.
S3_BIND_ADDRESS=127.0.0.1
