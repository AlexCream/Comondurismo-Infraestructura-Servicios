# Puerta de entrada (gateway) de Comondurismo: UN solo punto de acceso que reparte las
# peticiones a cada servicio segun la ruta.
#
# Este archivo es una plantilla: el contenedor sustituye las variables GATEWAY_* al
# arrancar (ver compose.yml y .env.example). Las rutas de cada servicio viven en
# gateway/locations/*.conf; para agregar un servicio basta con agregar un archivo alli.
#
# Hoy solo HTTP y sin dominio (se entra por localhost o por la IP del servidor).
# Cuando exista un dominio y certificado, reemplaza este archivo por
# gateway/tls/https.conf.template.example (ver README, seccion "Cuando tengas dominio").

# Necesario para WebSocket (p. ej. el servidor de desarrollo del frontend).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;

    # "_" = cualquier nombre o IP. Con dominio: GATEWAY_SERVER_NAME=api.tudominio.com
    server_name ${GATEWAY_SERVER_NAME};

    server_tokens off;

    # Resolver de Docker: nginx resuelve el nombre del servicio en cada peticion
    # (no solo al arrancar), asi que el gateway levanta aunque un servicio este caido
    # y sigue funcionando si ese servicio se recrea con otra IP.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Las APIs reciben JSON pequeno. Un servicio que suba archivos lo ampliara
    # en su propio location (client_max_body_size).
    client_max_body_size 1m;

    # add_header se declara aqui y no dentro de los location: si un location define
    # su propio add_header, deja de heredar los de este nivel.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Comprobacion de salud del propio gateway.
    location = /gateway/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Rutas de cada servicio.
    include /etc/nginx/locations/*.conf;
}
