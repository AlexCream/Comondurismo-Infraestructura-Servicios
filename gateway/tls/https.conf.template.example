# Version CON HTTPS del gateway. NO se usa hasta que lo actives (ver README, "Cuando
# tengas dominio"). Reemplaza a gateway/templates/default.conf.template:
#
#   cp gateway/tls/https.conf.template.example gateway/templates/default.conf.template
#
# Requisitos: un dominio apuntando a este servidor (registro A/AAAA) y un certificado.
# Variables (en .env): GATEWAY_SERVER_NAME=api.tudominio.com
# El certificado se espera en gateway/certs/<GATEWAY_SERVER_NAME>/fullchain.pem y privkey.pem
# (compose.yml monta esa carpeta; ver el bloque comentado "TLS" del servicio gateway).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---- HTTP: solo redirige a HTTPS (y deja pasar el desafio de Let's Encrypt) ----
server {
    listen 80 default_server;
    server_name ${GATEWAY_SERVER_NAME};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /gateway/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- Cualquier otro nombre o IP: se rechaza (evita servir la API por Host falsos) ----
server {
    listen 443 ssl default_server;
    ssl_certificate     /etc/nginx/certs/${GATEWAY_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${GATEWAY_SERVER_NAME}/privkey.pem;
    return 444;
}

# ---- HTTPS ----
server {
    listen 443 ssl;
    http2 on;
    server_name ${GATEWAY_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/${GATEWAY_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/${GATEWAY_SERVER_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # Activa HSTS solo cuando estes seguro de que HTTPS funciona: los navegadores lo
    # recuerdan y ya no dejan entrar por HTTP. Empieza con max-age bajo (p. ej. 300).
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /gateway/health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/locations/*.conf;
}
