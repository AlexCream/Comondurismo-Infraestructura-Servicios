# Frontend detras del gateway (opcional). Para activarlo:
#   1. renombra este archivo a 20-frontend.conf
#   2. borra 90-fallback.conf (ambos declaran "location /")
#   3. docker compose restart gateway   (o: docker compose exec gateway nginx -s reload)
#
# Ventaja: frontend y API quedan en el MISMO origen (http://localhost:8000), asi el
# navegador no hace peticiones entre origenes y CORS deja de importar.
# Recuerda ajustar en el .env de identidad EMAIL_VERIFICATION_URL, PASSWORD_RESET_URL y
# EMAIL_CHANGE_URL para que los enlaces de los correos apunten al origen del gateway.

# Desarrollo: servidor de Vite corriendo en tu maquina (puerto 5173, con HMR por WebSocket).
location / {
    set $frontend_upstream http://host.docker.internal:5173;
    proxy_pass $frontend_upstream;
    include /etc/nginx/snippets/proxy.conf;
}

# Produccion: sirve los archivos compilados en lugar del bloque anterior (monta el
# directorio "dist" del frontend en /usr/share/nginx/html).
#
# location / {
#     root /usr/share/nginx/html;
#     try_files $uri /index.html;
# }
