# Los binarios y los hashes no deben tocarse al clonar en Windows (autocrlf): un CRLF en
# SHA256SUMS hace fallar la verificacion, y un binario modificado no arranca.
bin/** -text
bin/**/SHA256SUMS text eol=lf
bin/**/VERSION text eol=lf
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
# Igual con la interfaz web compilada: sus hashes se calculan sobre los archivos tal cual.
web/dist/** -text
web/SHA256SUMS text eol=lf
web/VERSION text eol=lf
